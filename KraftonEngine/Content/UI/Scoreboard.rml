<rml>
<head>
	<style>
		body
		{
			font-family: Maplestory;
			font-weight: bold;
			width: 100%;
			height: 100%;
		}
		div#panel
		{
			position: absolute;
			left: 660dp;
			top: 180dp;
			width: 600dp;
			height: 720dp;
			background-color: rgba(0, 0, 0, 0.82);
			border-radius: 18dp;
			padding: 30dp;
		}
		div#title
		{
			font-size: 40dp;
			color: #ffd54a;
			text-align: center;
			margin-bottom: 24dp;
		}
		div#scorelist
		{
			font-size: 30dp;
			color: #ffffff;
			text-align: center;
			white-space: pre;
		}
	</style>
</head>
<body>
	<div id="panel">
		<div id="title">SCORE BOARD</div>
		<div id="scorelist">...</div>
	</div>
</body>
</rml>
